@{
    ViewData["Title"] = "至高無上 - 幫會首頁";
}

<div class="container mt-5">
    <!-- 幫會封面圖片 -->
    <div class="text-center">
        <div class="guild-banner"></div>
    </div>

    <!-- 幫會名稱與介紹 -->
    <div class="text-center mt-4">
        <h1 class="display-4 text-uppercase fw-bold gradient-text">至高無上</h1>
        <p class="lead text-dark">團結、無懼挑戰，這就是我們！</p>
    </div>

    <!-- 主要介紹區塊 -->
    <div class="row mt-5">
        <div class="col-md-6">
            <h3 class="fw-bold text-secondary">關於「至高無上」</h3>
            <p class="text-dark">
                「至高無上」招收喜歡PVP、喜歡熱鬧、愛打幫戰的小夥伴。希望有更多小夥伴一起共同成長！
            </p>
        </div>
        <div class="col-md-6">
            <h3 class="fw-bold text-secondary">加入我們</h3>
            <p class="text-dark">
                聯繫遊戲名稱:
                墨梓璿、琳琅、夫君威震八方、林栖、小貓兒
            </p>
        </div>
    </div>
</div>

@section Styles{
    <style>
        .guild-banner {
            background-image: url('/images/guild-banner.png');
            background-size: contain;
            background-position: center;
            background-repeat: no-repeat;
            height: 400px;
            width: 100%;
        }

        .gradient-text {
            background: linear-gradient(90deg, #ff758c, /* 深粉紅 */
            #ff7eb3, /* 亮粉紅 */
            #ff85a2, /* 櫻花粉 */
            #ff97b7, /* 淡粉 */
            #ffc2d1, /* 玫瑰粉 */
            #ffdde1, /* 淺粉白 */
            #ffdde1, 
            #ffdde1
            );
            -webkit-background-clip: text; /* 讓背景只顯示在文字內 */
            -webkit-text-fill-color: transparent;
            font-weight: bold;
        }
    </style>
}