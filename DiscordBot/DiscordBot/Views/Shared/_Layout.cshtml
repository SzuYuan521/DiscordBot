<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DiscordBot</title>

    <!-- 引用 Bootstrap 和 jQuery -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" asp-append-version="true" />
    <script src="~/lib/jquery/dist/jquery.min.js" asp-append-version="true"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js" asp-append-version="true"></script>

    <!-- 自定義CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    @RenderSection("Styles", required: false)
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light custom-navbar">
            <div class="container">
                <!-- 品牌 Logo -->
                <a class="navbar-brand fw-bold text-white" asp-controller="Home" asp-action="Index">DiscordBot</a>

                <!-- 響應式展開按鈕 -->
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                        aria-controls="navbarNav" aria-expanded="false" aria-label="切換導航">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- 導覽列選單 -->
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="Home" asp-action="Index">🏠 首頁</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-area="Bot" asp-controller="GuildMember" asp-action="OneLineBond">💖 一線牽管理</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-area="Bot" asp-controller="GuildMember" asp-action="Statistics">📊 統計查詢</a>
                        </li>
                        <!--li class="nav-item">
                            <a class="nav-link text-white" asp-controller="Home" asp-action="About">ℹ️ 關於</a>
                        </!--li-->
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container mt-4">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted text-center py-3">
        <div class="container">
            &copy; 2024 DiscordBot - <a asp-controller="Home" asp-action="Privacy" class="text-dark">隱私政策</a>
        </div>
    </footer>

    <!-- 確保 jQuery 和 Bootstrap JS 只加載一次 -->
    <script src="~/lib/jquery/dist/jquery.min.js" asp-append-version="true"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js" asp-append-version="true"></script>

    <!-- 預設的 Site JS -->
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
