@{
    ViewData["Title"] = "泰山移數據重載";
}

<div class="container mt-5 p-4 rounded shadow-lg" style="background-color: #ffe4e1;">
    <h2 class="text-center text-dark">🔄 更新資料庫數據</h2>

    <!-- 按鈕 -->
    <div class="d-flex justify-content-center mt-4">
        <button id="reloadTaishanMove" class="btn pink-btn px-4 py-2 shadow">🔄 重新載入泰山移數據</button>
        <button id="updateGuildMembers" class="btn pink-btn px-4 py-2 shadow ms-3">🔄 更新成員資料</button>
    </div>

    <!-- 訊息顯示 -->
    <div id="reloadMessage" class="text-center mt-3 text-dark fw-bold"></div>
</div>
@section Scripts {
    <script>
        $(document).ready(function () {
            function executeReload(url, buttonId, loadingText, successMessage) {
                let button = $(buttonId);
                button.prop("disabled", true).text(loadingText);
                $("#reloadMessage").text("");

                $.post(url, function (response) {
                    if (response.success) {
                        $("#reloadMessage").text(successMessage).css("color", "green");
                    } else {
                        $("#reloadMessage").text(response.message).css("color", "red");
                    }
                }).fail(function () {
                    $("#reloadMessage").text("❌ 伺服器錯誤，請稍後再試！").css("color", "red");
                }).always(function () {
                    button.prop("disabled", false).text(loadingText.replace("中...", ""));
                });
            }

            // 重新載入泰山移數據
            $("#reloadTaishanMove").click(function () {
                executeReload("/Bot/ReloadTaishanMoveData", "#reloadTaishanMove", "🔄 載入中...", "✅ 泰山移數據已重新載入！");
            });

            // 更新成員資料
            $("#updateGuildMembers").click(function () {
                executeReload("/Bot/UpdateGuildMembers", "#updateGuildMembers", "🔄 更新中...", "✅ 成員資料已成功更新！");
            });
        });
    </script>
}