@{
    ViewData["Title"] = "成員管理";
}

<div class="container mt-5 p-4 rounded shadow-lg" style="background-color: #ffe4e1;">
    <h2 class="text-center text-dark">🔄 更新資料庫數據</h2>

    <!-- 按鈕 -->
    <div class="d-flex justify-content-center mt-4">
        <button id="reloadTaishanMove" class="btn pink-btn px-4 py-2 shadow">🔄 重新載入泰山移數據</button>
        <button id="updateGuildMembers" class="btn pink-btn px-4 py-2 shadow ms-3">🔄 更新成員資料</button>
    </div>

    <!-- 訊息顯示 -->
    <div id="reloadMessage" class="text-center mt-3 text-dark fw-bold"></div>

    <!-- 成員列表 -->
    <div class="mt-5">
        <h4 class="text-center text-dark">👥 幫會成員列表</h4>
        <ul id="memberList" class="list-group mt-3"></ul>
    </div>
</div>

@section Scripts {
    <script>
        function loadMemberList() {
            $.get("/GuildMember/GetAllMembers", function (members) {
                const list = $("#memberList");
                list.empty();

                if (members.length === 0) {
                    list.append("<li class='list-group-item'>尚無成員資料</li>");
                    return;
                }

                members.forEach(member => {
                    const color = member.color || "";
                    const li = $("<li>")
                        .addClass("list-group-item fw-bold")
                        .text(member.memberName);

                    if (color) {
                        li.css("color", color);
                    }

                    list.append(li);
                });
            });
        }

        $(document).ready(function () {
            loadMemberList(); // 初始載入成員列表

            function executeReload(url, buttonId, loadingText, successMessage, originalText) {
                let button = $(buttonId);
                button.prop("disabled", true).text(loadingText);
                $("#reloadMessage").text("");

                $.post(url, function (response) {
                    if (response.success) {
                        $("#reloadMessage").text(successMessage).css("color", "green");
                        setTimeout(loadMemberList, 1000); // 延遲一秒重新讀取成員
                    } else {
                        $("#reloadMessage").text(response.message).css("color", "red");
                    }
                }).fail(function () {
                    $("#reloadMessage").text("❌ 伺服器錯誤，請稍後再試！").css("color", "red");
                }).always(function () {
                    button.prop("disabled", false).text(originalText); // ✅ 改成顯式還原原本文字
                });
            }

            // 重新載入泰山移數據
            $("#reloadTaishanMove").click(function () {
                executeReload("/GuildMember/ReloadTaishanMoveData", "#reloadTaishanMove", "🔄 載入中...", "✅ 泰山移數據已重新載入！", "🔄 重新載入泰山移數據");
            });

            // 更新成員資料
            $("#updateGuildMembers").click(function () {
                executeReload("/GuildMember/UpdateGuildMembers", "#updateGuildMembers", "🔄 更新中...", "✅ 成員資料已成功更新！", "🔄 更新成員資料");
            });
        });
    </script>
}