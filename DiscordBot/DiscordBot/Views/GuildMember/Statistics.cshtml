@{
    ViewData["Title"] = "統計數據查詢";
}

<!-- 整體背景設為淡粉紅色 -->
<div class="container mt-5 p-4 rounded shadow-lg" style="background-color: #ffe4e1;">
    <h2 class="text-center text-dark">📊 統計數據查詢</h2>

    <div class="row mb-3">
        <div class="col-md-6">
            <label for="statisticsType" class="form-label text-dark">選擇統計類型：</label>
            <select id="statisticsType" class="form-select border-2 shadow-sm">
                <option value="">請選擇...</option>
            </select>
        </div>
        <div class="col-md-6 d-flex align-items-end">
            <!-- 陰影按鈕 -->
            <button id="showMembers" class="btn pink-btn px-4 py-2 shadow">顯示成員</button>
        </div>
    </div>

    <!-- 固定顯示區塊 -->
    <div id="statisticsList" class="mt-3 p-3 border rounded shadow" style="display: none; background-color: #fff;">
        <h5 class="text-dark">符合條件的成員：</h5>
        <ul id="memberList" class="list-group"></ul>
    </div>
</div>

@section Styles {
    <style>
        /* 固定顯示區塊 */
        #statisticsList {
            border: 2px solid #ffb6c1;
        }
    </style>
}

@section Scripts {
    <script>
        $(document).ready(function () {
            // 加載統計類型到下拉選單
            $.get("/GuildMember/GetStatisticsTypes", function (data) {
                console.log(data);  // 檢查控制台輸出的資料
                let select = $("#statisticsType");
                select.empty(); // 清空選項
                select.append('<option value="">請選擇...</option>'); // 預設選項

                data.forEach(type => {
                    select.append(`<option value="${type.statisticsType}">${type.statisticsName}</option>`); // 使用 StatisticsName 顯示中文
                });
            });

            // 按鈕點擊事件
            $("#showMembers").click(function () {
                let selectedType = $("#statisticsType").val();
                if (!selectedType) {
                    alert("請選擇統計類型！");
                    return;
                }

                $.get(`/GuildMember/GetMembersByStatisticsType?statisticsType=${selectedType}`, function (data) {
                    let list = $("#memberList");
                    let statisticsListHeader = $("#statisticsList h5");

                    list.empty();
                    if (data.members.length > 0) {
                        // 顯示符合條件的統計名稱和數量
                        statisticsListHeader.text(`符合條件 ${data.statisticsName} 的成員：${data.memberCount} 人`);
                        data.members.forEach(member => {
                            list.append(`<li class="list-group-item">${member.memberName}</li>`);
                        });
                        $("#statisticsList").show();
                    } else {
                        statisticsListHeader.text(`目前沒有符合條件的 ${data.statisticsName} 成員。`);
                        list.append(`<li class="list-group-item">目前沒有符合條件的成員。</li>`);
                        $("#statisticsList").show();
                    }
                });
            });
        });
    </script>
}
